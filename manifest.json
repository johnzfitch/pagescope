{
  "manifest_version": 3,
  "name": "PageScope - Page Structure Inspector",
  "version": "0.0.6",
  "description": "Analyze page structure, accessibility tree, and interactive elements. Export detailed reports in JSON, Markdown, or plain text formats.",

  "icons": {
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png"
  },

  "permissions": [
    "activeTab",
    "storage",
    "scripting"
  ],

  "host_permissions": [
    "<all_urls>"
  ],


  "action": {
    "default_icon": "icons/icon-48.png",
    "default_title": "PageScope Inspector"
  },

  "sidebar_action": {
    "default_title": "PageScope",
    "default_panel": "sidebar/sidebar.html",
    "default_icon": "icons/icon-48.png"
  },

  "background": {
    "scripts": ["background.js"]
  },

  "options_ui": {
    "page": "options/options.html"
  },

  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'self'"
  },

  "browser_specific_settings": {
    "gecko": {
      "id": "pagescope@internetuniverse.org",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  },

  "developer": {
    "name": "Zack",
    "url": "https://github.com/johnzfitch/pagescope"
  },

  "homepage_url": "https://github.com/johnzfitch/pagescope"
}
